# Vault configuration for the wiki skill suite (llm-wiki Config Resolution Protocol).
# Copy to .env and fill in - .env is gitignored, this file is the tracked template.
VAULT_PATH="/absolute/path/to/vault"
VAULT_CATEGORIES="concepts,entities,skills,references,synthesis,journal"
VAULT_SOURCES_DIR="/absolute/path/to/vault/_raw"
VAULT_LINK_FORMAT="wikilink"
WIKI_TOKEN_WARN_THRESHOLD="100000"
WIKI_STAGED_WRITES="false"