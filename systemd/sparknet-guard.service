[Unit]
Description=Sparknet Critical File Guard (root-gated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/knowledge/sparknet
ExecStart=/usr/bin/python3 /mnt/knowledge/sparknet/services/sparknet-guard-d.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
