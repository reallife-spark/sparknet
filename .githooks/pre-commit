#!/usr/bin/env bash
# Pre-commit gate: keys-check, then a staged-format pass over Python.
#
# Wire it up once per clone with `make hooks` (sets core.hooksPath=.githooks).
# Git never installs hooks automatically, so this file existing is not the same
# as it running — `git config core.hooksPath` is how you prove it happened.
#
# Two layers, because there are two different kinds of mistake:
#
#   1. keys-check  — refuse a commit that tracks key material. Hard fail.
#   2. ruff format — reformat only the Python files this commit stages, re-stage
#      them, and stop, so the author reviews the formatted diff and commits again
#      (the same shape the dsx repos' pre-commit config uses). It is a soft
#      dependency: with no ruff available it reports and continues, so a node
#      without the dev tooling can still commit — keys-check is what must run.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "pre-commit: keys-check"
./scripts/sparknet-keys-check.sh

py="python3"
[ -x "$root/.venv/bin/python" ] && py="$root/.venv/bin/python"
if ! "$py" -m ruff --version >/dev/null 2>&1; then
  echo "pre-commit: ruff not available — format pass SKIPPED (install with 'make devtools')"
  exit 0
fi

staged=()
while IFS= read -r f; do
  case "$f" in
    *.py)
      # Role-local trees carry their own pyproject.toml; ruff would resolve
      # that config and format vendored files when they are named explicitly.
      case "$f" in
        .opencode/*|*/.opencode/*|references/*) continue ;;
      esac
      staged+=("$f")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#staged[@]}" -eq 0 ]; then
  echo "pre-commit: no staged Python files"
  exit 0
fi

if "$py" -m ruff format --check "${staged[@]}" >/dev/null 2>&1; then
  echo "pre-commit: staged Python already formatted"
  exit 0
fi

"$py" -m ruff format "${staged[@]}"
git add -- "${staged[@]}"
echo "pre-commit: reformatted staged Python and re-staged it — review the diff and commit again" >&2
exit 1
