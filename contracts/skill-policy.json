{
  "schema": "sparknet-skill-policy/1",
  "schema_version": "1.0",
  "description": "Grouping and visibility policy for the skill catalog. Featured ids are the only skills a model is advertised; everything else is searchable and loadable through the skills MCP. Denied groups are filtered before an entry reaches a surface.",
  "group_order": [
    "wiki",
    "understand",
    "engineering",
    "design",
    "data",
    "ai",
    "infra",
    "docs",
    "security",
    "legal",
    "spark",
    "other"
  ],
  "groups": {
    "wiki": "Knowledge capture, retrieval, linting and the vendored wiki suite.",
    "understand": "The /understand* code-understanding family.",
    "engineering": "Planning, implementation, review, testing and repository work.",
    "design": "Architecture, interfaces, API and visual design.",
    "data": "Data engineering, analysis and evaluation.",
    "ai": "Model runtimes, training, inference and document AI.",
    "infra": "Deployment, observability, containers and node operations.",
    "docs": "Document and communication formats.",
    "security": "Defensive security, review and compliance.",
    "legal": "German law and compliance material.",
    "spark": "DGX Spark and AGX node operations.",
