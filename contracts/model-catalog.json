{
  "schema_version": "1.0",
  "contract": "model-catalog",
  "description": "The operator-owned model catalog. It names every model the fabric may pull, which node may serve it, the quant, the runtime, the license and the approximate fit. Weights are not knowledge, not authority and never enter a vault, a bundle or 4223. The Master host (agx64, 64 GB) serves the teacher; the peer host (agx32, 32 GB) serves the student. The teacher is deliberately not eligible for agx32: a 32 GB node cannot serve it, and a cold backup of those weights there is not a deployment.",
  "updated": "2026-11-13",
  "store": {
    "root": "/mnt/ai/models",
    "manifest_dir": "manifests",
    "min_free_gb": 80,
    "note": "The store is a host path, never a vault path. A model pull is an operator action; it is not an LLM tool.",
    "active_root": "/opt/sparknet/models"
  },
  "role_placement": {
    "master": {
      "node": "agx64",
      "roles": [
        "teacher",
        "embedding"
      ],
      "why": "The 64 GB host runs the 30B-2507 main/teacher at 262k and the distilled 4B candidate."
    },
    "peer": {
      "node": "agx32",
      "roles": [
        "student",
        "coder",
        "vision",
        "embedding"
      ],
      "why": "The 32 GB peer runs the 4B-2507 student, the coder, the vision model and the embedding model on demand."
    }
  },
