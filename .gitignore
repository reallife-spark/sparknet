# Local vault config (paths only, but keep it out of history)
.env

# Review queue for LLM-written pages (WIKI_STAGED_WRITES=true).
# The root vault's category directory is documented in the charter and must
# survive a fresh clone, so it is tracked through its .gitkeep while its staged
# pages stay out of history. Ignoring the whole path meant a clone had no
# _staging/ at all, which is the phantom directory tests/test_layout.py exists to
# catch. The leading slash anchors this to the root vault.
/_staging/*
!/_staging/.gitkeep

# Role subvaults carry a transient queue of the same name. Neither role charter
# documents it, so it stays local: created where it is used, never in history.
*/_staging/

# Vault editor workspace state (machine-local)
.vault-config/workspace.json
.vault-config/workspace-mobile.json
.vault-config/cache

# Defensive: the desktop editor re-creates its own config dir if it reopens
# this vault. Ignore the whole directory — workspace state, appearance and
# plugin scratch are all machine-local and must never be committed.
.obsidian/

# Tooling noise
__pycache__/
*.pyc
.venv/
.trash/
.DS_Store

# Vault-local runtime state (see scripts/sparknet-env.sh)
.state/
.cache/

# Distribution archives
dist/

# Tool caches that self-ignore via an inner .gitignore, but only in recent
# versions. Declared here so a cache can never be committed by an older tool.
.ruff_cache/
.pytest_cache/

# Key material — the first line of defence, with `make keys-check` as the
# second. Private keys live under .state/ (mode 0700/0600) and are never
# committed, whatever directory one turns up in. Listed as bare patterns so
# scripts/sparknet-keys-check.sh can prove the backstop is still present.
*.ed25519
*.pem
*.key
privkey*
id_ed25519*
*.seed

# A local goSpark checkout is a separate Git repository (its own .git); it is a
# development reference, not a directory of this fabric.
/gospark/

# The Master's evidence repository is its own Git repository (Step 11); the
# fabric source must not embed it as a gitlink or copy its .git.
/master-node/evidence-repo/

# Generated by `make vault-health`
00_System/vault-health.json
