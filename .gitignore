# Local vault config (paths only, but keep it out of history)
.env

# Review queue for LLM-written pages (WIKI_STAGED_WRITES=true)
_staging/

# Vault editor workspace state (machine-local)
.vault-config/workspace.json
.vault-config/workspace-mobile.json
.vault-config/cache

# Defensive: the desktop editor re-creates its own config dir if it reopens
# this vault. Keep its workspace state out of history.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Tooling noise
__pycache__/
*.pyc
.venv/
.trash/
.DS_Store

# Vault-local runtime state (see scripts/sparknet-env.sh)
.state/
.cache/

# Distribution archives
dist/

# Tool caches that self-ignore via an inner .gitignore, but only in recent
# versions. Declared here so a cache can never be committed by an older tool.
.ruff_cache/
.pytest_cache/
