{
  "schema": "sparknet-model-runtime/1",
  "role": "master",
  "node": "agx32",
  "description": "The Master's on-demand student runtime. The teacher is not eligible here: a 32 GB node cannot serve it. Training gets an exclusive lease and stops student inference first.",
  "defaults": {
    "idle_stop_minutes": 30,
    "min_free_gb": 30,
    "health_timeout_seconds": 180,
    "memory_safety_gb": 4
  },
  "profiles": {
    "student": {
      "model_id": "qwen3.5-9b-q8",
      "compose_file": "master-node/configs/model-runtime/docker-compose.student.yml",
      "project": "sparknet-student",
      "profile": "student",
      "services": [
        "student"
      ],
      "model_env": "STUDENT_MODEL_FILE",
      "memory_gb": 12,
      "health_url": "http://127.0.0.1:8101/health",
      "idle_stop_minutes": 30,
      "conflicts": [
        "student-large"
      ]
    },
    "student-large": {
      "model_id": "qwen3.8-27b-q4",
      "compose_file": "master-node/configs/model-runtime/docker-compose.student.yml",
      "project": "sparknet-student",
      "profile": "student",
      "services": [
        "student"
      ],
      "model_env": "STUDENT_MODEL_FILE",
      "memory_gb": 20,
      "health_url": "http://127.0.0.1:8101/health",
      "idle_stop_minutes": 20,
      "conflicts": [
        "student"
      ]
    }
  }
}
